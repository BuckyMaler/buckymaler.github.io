---
import { Linkedin, Github, Twitter } from '@lucide/astro';
import avatar from '../assets/avatar.jpg';
import background from '../assets/background.svg';
---

<div id="container">
  <img id="background" src={background.src} fetchpriority="high" />
  <main>
    <section id="hero">
      <h1>
        <span
          >Hi, I'm <img src={avatar.src} alt="Bucky Maler" /><span
            >Bucky Maler!</span
          ></span
        >I'm a <span>software engineer</span> at <span>Kraken.</span>
      </h1>
      <section id="links">
        <a href="https://www.linkedin.com/in/buckymaler" target="_blank">
          <Linkedin />
        </a>
        <a href="https://github.com/BuckyMaler" target="_blank">
          <Github />
        </a>
        <a href="https://x.com/BuckyMaler" target="_blank">
          <Twitter />
        </a>
      </section>
    </section>
  </main>
</div>

<style>
  #container {
    height: 100%;
  }

  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }

  main {
    display: flex;
    justify-content: center;
    height: 100%;
  }

  #hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
  }

  h1 {
    font-size: clamp(16px, 7vw, 64px);
  }

  h1 span:first-child {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  h1 span:nth-child(2),
  h1 span:nth-child(3) {
    background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  h1 img {
    width: 11vw;
    max-width: 120px;
    margin: 0 16px;
    border: 4px solid transparent;
    border-radius: 32%;
    background:
      linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
      linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
  }

  #links {
    display: flex;
    gap: 32px;
  }

  #links a {
    color: #111827;
    text-decoration: none;
    transition: color 0.2s;
  }

  #links a:hover {
    color: rgb(78, 80, 86);
  }
</style>
